{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Computer Use",
  "version": "0.1.2",
  "identifier": "com.hermes.computer-use",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hermes Computer Use",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* http://ipc.localhost ws://localhost:* ws://127.0.0.1:* https://api.github.com https://github.com; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:;",
      "capabilities": ["default", "plugins-minimal", "updater"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Crown_22",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2RjFFQ0JDQjc2M0MzOTYKUldTV3cyTzN2T3p4bHBFSEM5alJwVmdQL21uMHNoWld0Mnh1Q2FXRG9NR2sxZEZwZ1BXVTFieEYK",
      "endpoints": [
        "https://github.com/SkyCrown111/Hermes-Computer-Use/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
